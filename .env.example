# Copy to .env for local `netlify dev`. In production set these in Netlify → Site configuration → Environment variables.
# Never commit real values. Only VITE_* variables reach the browser; everything else stays on the server.

# Recipients (server only). Comma-separate to add more than one address.
CONTACT_TO_MC=nalin@prismconsulting.org
CONTACT_TO_CM=renu@prismconsulting.org

# Sender. Must be on a domain verified in Resend (SPF + DKIM), e.g. Prism Consulting <forms@prismconsulting.org>
CONTACT_FROM_EMAIL=Prism Consulting <forms@prismconsulting.org>

# Resend API key (server only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: reject posts from other origins
ALLOWED_ORIGIN=https://prismconsulting.org

# Optional: Google reCAPTCHA v3 (invisible). Leave both blank to rely on the honeypot + rate limit only.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
