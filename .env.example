# Copy to .env for local `vercel dev` / `netlify dev`. In production set these in Vercel → Project → Settings → Environment Variables
# (or Netlify → Site configuration → Environment variables).
# Never commit real values. Only VITE_* variables reach the browser; everything else stays on the server.

# Recipients (server only). Comma-separate to add more than one address.
CONTACT_TO_MC=prismcounselling@gmail.com
CONTACT_TO_CM=prismcounselling@gmail.com

# --- Option A (current, Vercel): Gmail SMTP. When both are set, mail goes through Gmail and Resend is not used.
# SMTP_PASS is a Google App password (needs 2-Step Verification on the account), not the normal Gmail password.
SMTP_USER=prismcounselling@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Optional overrides for another SMTP provider (defaults: smtp.gmail.com, 465)
# SMTP_HOST=
# SMTP_PORT=

# --- Option B: Resend (used when SMTP_USER/SMTP_PASS are not set)

# Sender. With Gmail SMTP leave it unset (defaults to Prism Consulting <SMTP_USER>).
# With Resend it must be on a verified domain (SPF + DKIM), e.g. Prism Consulting <forms@prismconsulting.org>
# CONTACT_FROM_EMAIL=Prism Consulting <forms@prismconsulting.org>

# Resend API key (server only)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: reject posts from other origins (comma-separated). Leave unset for local dev and *.vercel.app previews,
# otherwise those requests get a 403.
# ALLOWED_ORIGIN=https://prismconsulting.org

# Optional: Google reCAPTCHA v3 (invisible). Leave both blank to rely on the honeypot + rate limit only.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
